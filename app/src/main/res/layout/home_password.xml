<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA"
    tools:context=".ui.home.HomePasswordActivity">

    <!-- Navbar superior -->
    <LinearLayout
        android:id="@+id/passwordNavbar"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="←"
            android:textColor="#151A1D"
            android:textSize="28sp"
            android:textStyle="bold" />

        <include
            android:id="@+id/includeNavbarLogo"
            layout="@layout/navbar_logo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <Space
            android:layout_width="48dp"
            android:layout_height="48dp" />

    </LinearLayout>

    <View
        android:id="@+id/dividerNavbar"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        app:layout_constraintTop_toBottomOf="@id/passwordNavbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Contenido -->
    <LinearLayout
        android:id="@+id/passwordContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#F7F8FA"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="42dp"
        android:paddingEnd="22dp"
        android:paddingBottom="28dp"
        app:layout_constraintTop_toBottomOf="@id/dividerNavbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Cambiar Contraseña"
            android:textColor="#151A1D"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="4dp"
            android:text="Tu nueva contraseña debe ser diferente de las\nanteriores para garantizar la seguridad de tu cuenta."
            android:textColor="#4B5060"
            android:textSize="16sp" />

        <!-- Nueva contraseña -->
        <TextView
            android:id="@+id/lblNewPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="Nueva Contraseña"
            android:textColor="#151A1D"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/newPasswordContainer"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="#F3F4F6"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="14dp">

            <EditText
                android:id="@+id/txtNewPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Mínimo 8 caracteres"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="#151A1D"
                android:textColorHint="#C2C5D3"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnShowNewPassword"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="◉"
                android:textColor="#4B5060"
                android:textSize="20sp" />

        </LinearLayout>

        <!-- Confirmar contraseña -->
        <TextView
            android:id="@+id/lblConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Confirmar Contraseña"
            android:textColor="#151A1D"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/confirmPasswordContainer"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="#F3F4F6"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="14dp">

            <EditText
                android:id="@+id/txtConfirmPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Repite tu contraseña"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="#151A1D"
                android:textColorHint="#C2C5D3"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnShowConfirmPassword"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="◉"
                android:textColor="#4B5060"
                android:textSize="20sp" />

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="64dp" />

        <!-- Botón continuar -->
        <Button
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:backgroundTint="#151A1D"
            android:text="Continuar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/loaderPassword"
            style="?android:attr/progressBarStyle"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <!-- Separador -->
        <LinearLayout
            android:id="@+id/separatorContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#CDD2E0" />

            <TextView
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="o"
                android:textColor="#C2C5D3"
                android:textSize="16sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#CDD2E0" />

        </LinearLayout>

        <!-- Volver login -->
        <TextView
            android:id="@+id/btnBackLogin"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:background="#FFFFFF"
            android:gravity="center"
            android:text="Volver al inicio de sesión"
            android:textColor="#151A1D"
            android:textSize="16sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
