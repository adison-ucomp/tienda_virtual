<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/buyerMenu"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:elevation="8dp"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="48dp"
    android:paddingEnd="24dp"
    android:paddingBottom="32dp">

    <!-- Información del usuario -->
    <LinearLayout
        android:id="@+id/userInfoContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgUserProfile"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Foto de perfil"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/txtUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Juan Pérez"
            android:textColor="#222222"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/txtUserEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="juan.perez@email.co"
            android:textColor="#777777"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Separador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="52dp"
        android:layout_marginBottom="18dp"
        android:background="#F0F0F0" />

    <!-- Opción Configuración -->
    <LinearLayout
        android:id="@+id/navConfiguration"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="⚙"
            android:textColor="#5F6673"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Configuración"
            android:textColor="#5F6673"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- Opción Soporte -->
    <LinearLayout
        android:id="@+id/navSupport"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="?"
            android:textColor="#5F6673"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Soporte"
            android:textColor="#5F6673"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- Opción Cerrar Sesión -->
    <LinearLayout
        android:id="@+id/navLogout"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="↪"
            android:textColor="#5F6673"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Cerrar Sesión"
            android:textColor="#5F6673"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- Espaciador para mandar el logo abajo -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Logo inferior -->
    <TextView
        android:id="@+id/txtMenuLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.12"
        android:text="EMPTIO"
        android:textColor="#222222"
        android:textSize="26sp" />

</LinearLayout>
