<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".ui.platform.BuyerPurchaseActivity">

    <!-- Navbar superior con botón regresar -->
    <LinearLayout
        android:id="@+id/purchaseNavbarContainer"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="←"
            android:textColor="#111111"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPurchaseTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Finalizar Compra"
            android:textColor="#111111"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="48dp"
            android:layout_height="48dp" />

    </LinearLayout>

    <View
        android:id="@+id/dividerNavbar"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        app:layout_constraintTop_toBottomOf="@id/purchaseNavbarContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Contenido principal -->
    <ScrollView
        android:id="@+id/scrollPurchase"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FFFFFF"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/dividerNavbar"
        app:layout_constraintBottom_toTopOf="@id/bottomPurchaseAction"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/purchaseContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="30dp"
            android:paddingEnd="24dp"
            android:paddingBottom="30dp">

            <!-- Dirección de envío -->
            <LinearLayout
                android:id="@+id/addressHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtAddressTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Dirección de Envío"
                    android:textColor="#111111"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnEditAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EDITAR"
                    android:textColor="#747A8C"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Mapa temporal -->
            <FrameLayout
                android:id="@+id/mapContainer"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="18dp"
                android:background="#DDF2EB">

                <TextView
                    android:id="@+id/txtMapFake"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Bogotá"
                    android:textColor="#151A1D"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/iconMapPin"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="●"
                    android:textColor="#111111"
                    android:textSize="28sp" />

            </FrameLayout>

            <TextView
                android:id="@+id/txtAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Calle 85 # 11-53, Apartamento 402"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Chapinero, Bogotá, D.C."
                android:textColor="#747A8C"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtContact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Juan Pérez · 300 123 4567"
                android:textColor="#747A8C"
                android:textSize="13sp" />

            <View
                android:id="@+id/dividerAddress"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="36dp"
                android:background="#EEEEEE" />

            <!-- Método de pago -->
            <TextView
                android:id="@+id/txtPaymentTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:text="Método de Pago"
                android:textColor="#111111"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Tarjeta -->
            <LinearLayout
                android:id="@+id/paymentCreditCard"
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/iconCreditCard"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="▭"
                    android:textColor="#4B5060"
                    android:textSize="24sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtCreditCardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tarjeta de Crédito"
                        android:textColor="#111111"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtCreditCardDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Visa terminada en •••• 4242"
                        android:textColor="#747A8C"
                        android:textSize="12sp" />

                </LinearLayout>

                <RadioButton
                    android:id="@+id/radioCreditCard"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:buttonTint="#0047B3"
                    android:checked="true" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE" />

            <!-- Transferencia -->
            <LinearLayout
                android:id="@+id/paymentTransfer"
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/iconTransfer"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="▥"
                    android:textColor="#4B5060"
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTransferTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Transferencia Bancaria"
                        android:textColor="#111111"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtTransferDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="PSE"
                        android:textColor="#747A8C"
                        android:textSize="12sp" />

                </LinearLayout>

                <RadioButton
                    android:id="@+id/radioTransfer"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:buttonTint="#0047B3" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE" />

            <!-- Efectivo -->
            <LinearLayout
                android:id="@+id/paymentCash"
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/iconCash"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="▣"
                    android:textColor="#4B5060"
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtCashTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Efectivo"
                        android:textColor="#111111"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtCashDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Efecty o Baloto"
                        android:textColor="#747A8C"
                        android:textSize="12sp" />

                </LinearLayout>

                <RadioButton
                    android:id="@+id/radioCash"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:buttonTint="#0047B3" />

            </LinearLayout>

            <View
                android:id="@+id/dividerPayment"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="26dp"
                android:background="#EEEEEE" />

            <!-- Resumen -->
            <TextView
                android:id="@+id/txtSummaryTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:text="Resumen"
                android:textColor="#111111"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/rowProducts"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Productos (2)"
                    android:textColor="#747A8C"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtProductsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$ 145.000"
                    android:textColor="#111111"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowShipping"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Envío"
                    android:textColor="#747A8C"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtShippingValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gratis"
                    android:textColor="#111111"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowTaxes"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="IVA (19%)"
                    android:textColor="#747A8C"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtTaxesValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$ 27.550"
                    android:textColor="#111111"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Barra inferior -->
    <LinearLayout
        android:id="@+id/bottomPurchaseAction"
        android:layout_width="0dp"
        android:layout_height="86dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/totalContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTotalLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL"
                android:textColor="#747A8C"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTotalValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="$ 172.550"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <Button
            android:id="@+id/btnConfirmPurchase"
            android:layout_width="190dp"
            android:layout_height="54dp"
            android:backgroundTint="#151A1D"
            android:text="Confirmar  →"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>