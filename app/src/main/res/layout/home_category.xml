<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".ui.home.HomeCategoryActivity">

    <!-- Navbar superior -->
    <include
        android:id="@+id/includeHomeNavbar"
        layout="@layout/navbar_buyer_superior"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Contenido principal -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FFFFFF"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/includeHomeNavbar"
        app:layout_constraintBottom_toTopOf="@id/includeHomeInferior"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="32dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <!-- Título -->
            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Categorías"
                android:textColor="#151A1D"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/txtSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Explora por departamento"
                android:textColor="#747A8C"
                android:textSize="14sp" />

            <!-- Categoría Tecnología -->
            <LinearLayout
                android:id="@+id/categoryTechnology"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="26dp"
                android:background="#F7F8FA"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <TextView
                    android:id="@+id/iconTechnology"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:text="▣"
                    android:textColor="#151A1D"
                    android:textSize="24sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTechnologyTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tecnología"
                        android:textColor="#151A1D"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtTechnologyDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Dispositivos y accesorios"
                        android:textColor="#747A8C"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Categoría Deporte -->
            <LinearLayout
                android:id="@+id/categorySport"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="20dp"
                android:background="#F7F8FA"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <TextView
                    android:id="@+id/iconSport"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:text="🎮"
                    android:textColor="#151A1D"
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtSportTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Deporte"
                        android:textColor="#151A1D"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSportDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Esgrima"
                        android:textColor="#747A8C"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Menú inferior -->
    <include
        android:id="@+id/includeHomeInferior"
        layout="@layout/navbar_buyer_inferior"
        android:layout_width="0dp"
        android:layout_height="76dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>