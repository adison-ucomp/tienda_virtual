<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".ui.platform.BuyerShoppingActivity">

    <!-- Navbar superior -->
    <include
        android:id="@+id/includeHomeNavbar"
        layout="@layout/navbar_buyer_superior"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Contenido principal -->
    <ScrollView
        android:id="@+id/scrollShopping"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FFFFFF"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/includeHomeNavbar"
        app:layout_constraintBottom_toTopOf="@id/includeHomeInferior"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/shoppingContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="26dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <!-- Título -->
            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mis Compras"
                android:textColor="#111111"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Revisa el estado de tus pedidos recientes."
                android:textColor="#747A8C"
                android:textSize="14sp" />

            <!-- Compra 1 -->
            <LinearLayout
                android:id="@+id/shoppingItemOne"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgShoppingOne"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:background="#98D5CF"
                    android:contentDescription="Imagen compra"
                    android:padding="38dp"
                    android:scaleType="centerInside"
                    android:src="@mipmap/ic_launcher" />

                <LinearLayout
                    android:id="@+id/statusRowOne"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtStatusOne"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="●  ENTREGADO"
                        android:textColor="#111111"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDateOne"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12 FEB"
                        android:textColor="#747A8C"
                        android:textSize="10sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/infoRowOne"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtProductOne"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Smartphone Galaxy S24\nUltra 256GB"
                        android:textColor="#111111"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/txtPriceOne"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$3.500.000"
                        android:textColor="#111111"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txtCodeOne"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="#EMP-84920"
                    android:textColor="#747A8C"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Compra 2 -->
            <LinearLayout
                android:id="@+id/shoppingItemTwo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="42dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgShoppingTwo"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:background="#111111"
                    android:contentDescription="Imagen compra"
                    android:padding="38dp"
                    android:scaleType="centerInside"
                    android:src="@mipmap/ic_launcher" />

                <LinearLayout
                    android:id="@+id/statusRowTwo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtStatusTwo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="●  EN CAMINO"
                        android:textColor="#111111"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDateTwo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10 FEB"
                        android:textColor="#747A8C"
                        android:textSize="10sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/infoRowTwo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtProductTwo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Auriculares Noise\nCancelling Pro"
                        android:textColor="#111111"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/txtPriceTwo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$850.000"
                        android:textColor="#111111"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txtCodeTwo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="#EMP-84915"
                    android:textColor="#747A8C"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Compra 3 -->
            <LinearLayout
                android:id="@+id/shoppingItemThree"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="42dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgShoppingThree"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:background="#1A1A1A"
                    android:contentDescription="Imagen compra"
                    android:padding="38dp"
                    android:scaleType="centerInside"
                    android:src="@mipmap/ic_launcher" />

                <LinearLayout
                    android:id="@+id/statusRowThree"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtStatusThree"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="○  PROCESANDO"
                        android:textColor="#111111"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDateThree"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOY"
                        android:textColor="#747A8C"
                        android:textSize="10sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/infoRowThree"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtProductThree"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Laptop UltraBook Serie X\n16GB RAM"
                        android:textColor="#111111"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/txtPriceThree"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$4.200.000"
                        android:textColor="#111111"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txtCodeThree"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="#EMP-84931"
                    android:textColor="#747A8C"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Menú inferior -->
    <include
        android:id="@+id/includeHomeInferior"
        layout="@layout/navbar_buyer_inferior"
        android:layout_width="0dp"
        android:layout_height="76dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>