<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".ui.platform.HomeDetailActivity">

    <!-- Navbar superior con botón regresar -->
    <LinearLayout
        android:id="@+id/detailNavbarContainer"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="←"
            android:textColor="#111111"
            android:textSize="28sp"
            android:textStyle="bold" />

        <include
            android:id="@+id/includeNavbarHome"
            layout="@layout/navbar_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Contenido principal -->
    <ScrollView
        android:id="@+id/scrollDetail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FFFFFF"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/detailNavbarContainer"
        app:layout_constraintBottom_toTopOf="@id/bottomActions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/detailContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <!-- Título producto -->
            <LinearLayout
                android:id="@+id/headerProduct"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtProductName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="2dp"
                        android:text="Smartphone\nVertex\nPro Max 5G"
                        android:textColor="#151A1D"
                        android:textSize="25sp" />

                    <TextView
                        android:id="@+id/txtProductType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Tienda"
                        android:textColor="#747A8C"
                        android:textSize="13sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/btnFavorite"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="♡"
                    android:textColor="#151A1D"
                    android:textSize="28sp" />

            </LinearLayout>

            <!-- Imagen principal -->
            <FrameLayout
                android:id="@+id/mainImageContainer"
                android:layout_width="match_parent"
                android:layout_height="270dp"
                android:layout_marginTop="24dp"
                android:background="#F7F8FA">

                <ImageView
                    android:id="@+id/imgProductMain"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="26dp"
                    android:layout_marginTop="28dp"
                    android:layout_marginEnd="26dp"
                    android:layout_marginBottom="28dp"
                    android:background="#151515"
                    android:contentDescription="Imagen principal del producto"
                    android:padding="48dp"
                    android:scaleType="centerInside"
                    android:src="@mipmap/ic_launcher" />

                <TextView
                    android:id="@+id/txtDiscount"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginTop="18dp"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="-15% DTO"
                    android:textColor="#151A1D"
                    android:textSize="11sp" />

            </FrameLayout>

            <!-- Miniaturas -->
            <LinearLayout
                android:id="@+id/thumbContainer"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/thumbOne"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="#151515"
                    android:contentDescription="Miniatura 1"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@mipmap/ic_launcher" />

                <ImageView
                    android:id="@+id/thumbTwo"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="14dp"
                    android:background="#747A8C"
                    android:contentDescription="Miniatura 2"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@mipmap/ic_launcher" />

                <ImageView
                    android:id="@+id/thumbThree"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="14dp"
                    android:background="#747A8C"
                    android:contentDescription="Miniatura 3"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@mipmap/ic_launcher" />

            </LinearLayout>

            <!-- Especificaciones clave -->
            <TextView
                android:id="@+id/txtSpecsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Especificaciones clave"
                android:textColor="#151A1D"
                android:textSize="20sp" />

            <GridLayout
                android:id="@+id/specGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:columnCount="2"
                android:rowCount="2">

                <!-- Procesador -->
                <LinearLayout
                    android:id="@+id/specProcessor"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="#F7F8FA"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚙"
                        android:textColor="#151A1D"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="PROCESADOR"
                        android:textColor="#747A8C"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Octa-Core\n3.2GHz"
                        android:textColor="#151A1D"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- Almacenamiento -->
                <LinearLayout
                    android:id="@+id/specStorage"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="#F7F8FA"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▤"
                        android:textColor="#151A1D"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="ALMACENAMIENTO"
                        android:textColor="#747A8C"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="256 GB ROM"
                        android:textColor="#151A1D"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- Cámara -->
                <LinearLayout
                    android:id="@+id/specCamera"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="8dp"
                    android:background="#F7F8FA"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▣"
                        android:textColor="#151A1D"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="CÁMARA"
                        android:textColor="#747A8C"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="108 MP + 12 MP"
                        android:textColor="#151A1D"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- Batería -->
                <LinearLayout
                    android:id="@+id/specBattery"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="8dp"
                    android:background="#F7F8FA"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▯"
                        android:textColor="#151A1D"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="BATERÍA"
                        android:textColor="#747A8C"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="5000 mAh"
                        android:textColor="#151A1D"
                        android:textSize="13sp" />

                </LinearLayout>

            </GridLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="30dp"
                android:background="#EEEEEE" />

            <!-- Sobre producto -->
            <TextView
                android:id="@+id/txtAboutTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sobre este producto"
                android:textColor="#151A1D"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/txtAboutDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="5dp"
                android:text="Experimenta el futuro hoy con el nuevo Vertex Pro Max 5G. Diseñado para ofrecer un rendimiento inigualable, este dispositivo cuenta con un sistema de cámara triple avanzado para capturar cada momento con detalle profesional. Su pantalla fluida y su batería de larga duración lo convierten en el compañero ideal para el trabajo y el entretenimiento."
                android:textColor="#747A8C"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtViewSpecs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:letterSpacing="0.08"
                android:text="VER TODAS LAS ESPECIFICACIONES  →"
                android:textColor="#151A1D"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

    <!-- Botones inferiores -->
    <LinearLayout
        android:id="@+id/bottomActions"
        android:layout_width="0dp"
        android:layout_height="86dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnAddCart"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:letterSpacing="0.08"
            android:text="AÑADIR AL CARRITO"
            android:textAllCaps="false"
            android:textColor="#151A1D"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnBuyNow"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:backgroundTint="#151A1D"
            android:letterSpacing="0.08"
            android:text="COMPRAR AHORA"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>