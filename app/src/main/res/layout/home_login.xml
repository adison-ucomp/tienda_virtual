<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeLoginActivity">

    <!-- Navbar Superior -->
    <include
        android:id="@+id/includenavbarBuyerSuperior"
        layout="@layout/navbar_logo"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/dividerNavbar"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#111111"
        app:layout_constraintTop_toBottomOf="@id/includenavbarBuyerSuperior"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/loginContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#F7F8FA"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/dividerNavbar"
        app:layout_constraintBottom_toTopOf="@id/includeBuyerIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Body -->
        <LinearLayout
            android:id="@+id/loginBody"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="40dp"
            android:paddingEnd="22dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/txtWelcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Bienvenido"
                android:textColor="#151A1D"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Ingresa tus credenciales para continuar"
                android:textColor="#4B5060"
                android:textSize="16sp" />

            <!-- Correo -->
            <TextView
                android:id="@+id/lblEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="Correo Electrónico"
                android:textColor="#4B5060"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/fieldEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="#FFFFFF"
                android:hint="email@domain.com"
                android:inputType="textEmailAddress"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="#151A1D"
                android:textColorHint="#C2C5D3"
                android:textSize="16sp" />

            <!-- Fila contraseña -->
            <LinearLayout
                android:id="@+id/passwordHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lblPassword"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Contraseña"
                    android:textColor="#4B5060"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/txtForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Olvidaste tu contraseña?"
                    android:textColor="#0047B3"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Campo contraseña -->
            <LinearLayout
                android:id="@+id/passwordContainer"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <EditText
                    android:id="@+id/fieldPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="•••••••••"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:textColor="#151A1D"
                    android:textColorHint="#C2C5D3"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/btnShowPassword"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="◉"
                    android:textColor="#4B5060"
                    android:textSize="20sp" />

            </LinearLayout>

            <!-- Botón iniciar sesión -->
            <Button
                android:id="@+id/actionExecute"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="26dp"
                android:backgroundTint="#151A1D"
                android:text="Iniciar Sesión"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/loaderLogin"
            style="?android:attr/progressBarStyle"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:indeterminate="true"
            android:visibility="gone" />

            <!-- Separador -->
            <LinearLayout
                android:id="@+id/separatorContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#CDD2E0" />

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="o"
                    android:textColor="#4B5060"
                    android:textSize="16sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#CDD2E0" />

            </LinearLayout>

            <!-- Registro comprador -->
            <TextView
                android:id="@+id/actionBuyer"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="34dp"
                android:background="#FFFFFF"
                android:gravity="center"
                android:text="🛒  Registrarme como Comprador"
                android:textColor="#151A1D"
                android:textSize="17sp" />

            <!-- Registro vendedor -->
            <TextView
                android:id="@+id/actionSeller"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="14dp"
                android:background="#FFFFFF"
                android:gravity="center"
                android:text="▦  Registrarme como Vendedor"
                android:textColor="#151A1D"
                android:textSize="17sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="© EMPTIO Colombia"
                android:textColor="#7A7F8F"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Menú inferior -->
    <include
        android:id="@+id/includeBuyerIcon"
        layout="@layout/navbar_buyer_inferior"
        android:layout_width="0dp"
        android:layout_height="76dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
