<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_layout"
    tools:context=".ui.buyer.BuyerMapsActivity">

    
    <LinearLayout
        android:id="@+id/mapsNavbarContainer"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="←"
            android:textColor="#111111"
            android:textSize="28sp"
            android:textStyle="bold" />
        
        <TextView
            android:id="@+id/txtMapsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Gestionar Dirección"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold" />
        
        <Space
            android:layout_width="48dp"
            android:layout_height="48dp" />
    
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollMaps"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/mapsNavbarContainer"
        app:layout_constraintBottom_toTopOf="@id/bottomSaveContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/mapsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:id="@+id/searchContainer"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="#F7F8FA"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <EditText
                    android:id="@+id/txtSearchAddress"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Buscar una dirección..."
                    android:imeOptions="actionSearch"
                    android:inputType="textPostalAddress"
                    android:singleLine="true"
                    android:textColor="#151A1D"
                    android:textColorHint="#747A8C"
                    android:textSize="14sp" />
                
                <TextView
                    android:id="@+id/btnSearchAddress"
                    android:layout_width="56dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="⌕"
                    android:textSize="24sp"
                    android:textColor="#111111" />
            
            </LinearLayout>

            <FrameLayout
                android:id="@+id/mapContainer"
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:layout_marginTop="18dp"
                android:background="#F7F8FA">
                
                <fragment
                    android:id="@+id/mapFragment"
                    android:name="com.google.android.gms.maps.SupportMapFragment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
                
                <TextView
                    android:id="@+id/btnUseCurrentLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#FFFFFF"
                    android:elevation="6dp"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="⌾  Usar mi ubicación actual"
                    android:textColor="#111111"
                    android:textSize="13sp" />
            
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Ubicación"
                android:textColor="#4B5060"
                android:textSize="14sp" />
            
            <Spinner
                android:id="@+id/spnUbication"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="#F7F8FA"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Dirección"
                android:textColor="#4B5060"
                android:textSize="14sp" />
            
            <EditText
                android:id="@+id/txtAddressDetail"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginTop="8dp"
                android:background="#F7F8FA"
                android:gravity="top"
                android:hint="Dirección seleccionada"
                android:inputType="textMultiLine"
                android:padding="16dp"
                android:textColor="#151A1D"
                android:textColorHint="#8C91A0"
                android:textSize="14sp" />
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Etiqueta"
                android:textColor="#4B5060"
                android:textSize="14sp" />
            
            <EditText
                android:id="@+id/txtLabel"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="#F7F8FA"
                android:hint="Ej. Mi casa principal"
                android:inputType="textCapWords"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="#151A1D"
                android:textColorHint="#8C91A0"
                android:textSize="14sp" />
        
        </LinearLayout>
    
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomSaveContainer"
        android:layout_width="0dp"
        android:layout_height="84dp"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <Button
            android:id="@+id/btnSaveAddress"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#151A1D"
            android:text="Guardar Dirección"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
