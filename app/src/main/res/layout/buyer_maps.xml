<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".ui.platform.BuyerMapsActivity">

    <!-- Navbar superior con botón regresar -->
    <LinearLayout
        android:id="@+id/mapsNavbarContainer"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="←"
            android:textColor="#111111"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtMapsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Gestionar Dirección"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="48dp"
            android:layout_height="48dp" />

    </LinearLayout>

    <View
        android:id="@+id/dividerNavbar"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        app:layout_constraintTop_toBottomOf="@id/mapsNavbarContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Contenido principal -->
    <ScrollView
        android:id="@+id/scrollMaps"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FFFFFF"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/dividerNavbar"
        app:layout_constraintBottom_toTopOf="@id/bottomSaveContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/mapsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- Buscador -->
            <LinearLayout
                android:id="@+id/searchContainer"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="#F7F8FA"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/iconSearch"
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="⌕"
                    android:textColor="#4B5060"
                    android:textSize="22sp" />

                <EditText
                    android:id="@+id/txtSearchAddress"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Buscar una dirección..."
                    android:inputType="textPostalAddress"
                    android:singleLine="true"
                    android:textColor="#151A1D"
                    android:textColorHint="#747A8C"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Mapa visual temporal -->
            <FrameLayout
                android:id="@+id/mapPreviewContainer"
                android:layout_width="match_parent"
                android:layout_height="390dp"
                android:layout_marginTop="18dp"
                android:background="#DDF2EB">

                <TextView
                    android:id="@+id/txtMapBackground"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:lineSpacingExtra="8dp"
                    android:text="MAPA\n\nVista temporal de ubicación"
                    android:textColor="#8C91A0"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/iconMapPin"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="⌖"
                    android:textColor="#E53935"
                    android:textSize="72sp" />

                <TextView
                    android:id="@+id/btnUseCurrentLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="⌾  Usar mi ubicación actual"
                    android:textColor="#111111"
                    android:textSize="13sp" />

            </FrameLayout>

            <!-- Formulario inferior -->
            <LinearLayout
                android:id="@+id/formAddressContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-8dp"
                android:background="#FFFFFF"
                android:elevation="4dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="18dp"
                android:paddingEnd="16dp"
                android:paddingBottom="18dp">

                <TextView
                    android:id="@+id/lblLocationName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nombre de la ubicación"
                    android:textColor="#4B5060"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/txtLocationName"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="#F7F8FA"
                    android:hint="Ej. Casa, Oficina, Gimnasio"
                    android:inputType="textCapWords"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:textColor="#151A1D"
                    android:textColorHint="#8C91A0"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/lblAddressDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Detalles adicionales"
                    android:textColor="#4B5060"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/txtAddressDetail"
                    android:layout_width="match_parent"
                    android:layout_height="84dp"
                    android:layout_marginTop="8dp"
                    android:background="#F7F8FA"
                    android:gravity="top"
                    android:hint="Piso, número de departamento, indicaciones de llegada..."
                    android:inputType="textMultiLine"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
                    android:textColor="#151A1D"
                    android:textColorHint="#8C91A0"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Botón inferior guardar -->
    <LinearLayout
        android:id="@+id/bottomSaveContainer"
        android:layout_width="0dp"
        android:layout_height="84dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnSaveAddress"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:backgroundTint="#151A1D"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="▣  Guardar Dirección"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>