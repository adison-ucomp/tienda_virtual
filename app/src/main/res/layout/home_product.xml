<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".ui.external.HomeProductActivity">

    <!-- Navbar Superior -->
    <include
        android:id="@+id/includeBuyerNavbar"
        layout="@layout/home_navbar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Contenido Principal -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FFFFFF"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/includeBuyerNavbar"
        app:layout_constraintBottom_toTopOf="@id/includeBuyerIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- Buscador -->
            <include
                android:id="@+id/includeHomeSearch"
                layout="@layout/home_search" />

            <!-- Categorías -->
            <include
                android:id="@+id/includeHomeCategory"
                layout="@layout/home_category" />

            <!-- Sugerencias -->
            <LinearLayout
                android:id="@+id/headerSuggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtSuggestionsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sugerencias"
                    android:textColor="#111111"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/txtViewAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VER TODO"
                    android:textColor="#111111"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <View
                android:id="@+id/dividerSuggestions"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="24dp"
                android:background="#EEEEEE" />

            <!-- Productos visibles en formato 2 columnas x 2 filas -->
            <GridLayout
                android:id="@+id/productGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2">

                <!-- Producto 1 -->
                <LinearLayout
                    android:id="@+id/productOne"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="28dp"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgProductOne"
                        android:layout_width="match_parent"
                        android:layout_height="170dp"
                        android:background="#F7F7F7"
                        android:contentDescription="Imagen del producto"
                        android:padding="42dp"
                        android:scaleType="centerInside"
                        android:src="@mipmap/ic_launcher" />

                    <TextView
                        android:id="@+id/txtProductOneName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Smartphone Vertex\nPro Max 5G"
                        android:textColor="#111111"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtProductOnePrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="$240.00"
                        android:textColor="#777777"
                        android:textSize="15sp" />

                </LinearLayout>

                <!-- Producto 2 -->
                <LinearLayout
                    android:id="@+id/productTwo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginBottom="28dp"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgProductTwo"
                        android:layout_width="match_parent"
                        android:layout_height="170dp"
                        android:background="#F7F7F7"
                        android:contentDescription="Imagen del producto"
                        android:padding="42dp"
                        android:scaleType="centerInside"
                        android:src="@mipmap/ic_launcher" />

                    <TextView
                        android:id="@+id/txtProductTwoName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Iphone 11"
                        android:textColor="#111111"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtProductTwoPrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="$35.00"
                        android:textColor="#777777"
                        android:textSize="15sp" />

                </LinearLayout>

                <!-- Producto 3 -->
                <LinearLayout
                    android:id="@+id/productThree"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgProductThree"
                        android:layout_width="match_parent"
                        android:layout_height="170dp"
                        android:background="#F7F7F7"
                        android:contentDescription="Imagen del producto"
                        android:padding="42dp"
                        android:scaleType="centerInside"
                        android:src="@mipmap/ic_launcher" />

                    <TextView
                        android:id="@+id/txtProductThreeName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Guante Sable"
                        android:textColor="#111111"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtProductThreePrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="$85.00"
                        android:textColor="#777777"
                        android:textSize="15sp" />

                </LinearLayout>

                <!-- Producto 4 -->
                <LinearLayout
                    android:id="@+id/productFour"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgProductFour"
                        android:layout_width="match_parent"
                        android:layout_height="170dp"
                        android:background="#F7F7F7"
                        android:contentDescription="Imagen del producto"
                        android:padding="42dp"
                        android:scaleType="centerInside"
                        android:src="@mipmap/ic_launcher" />

                    <TextView
                        android:id="@+id/txtProductFourName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Lámpara de Estudio"
                        android:textColor="#111111"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtProductFourPrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="$120.00"
                        android:textColor="#777777"
                        android:textSize="15sp" />

                </LinearLayout>

            </GridLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Menú inferior -->
    <include
        android:id="@+id/includeBuyerIcon"
        layout="@layout/home_inferior"
        android:layout_width="0dp"
        android:layout_height="76dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>