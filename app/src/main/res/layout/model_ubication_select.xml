<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_layout"
    android:fitsSystemWindows="true"
    tools:context=".ui.model.ubication.UbicationSelectActivity">

    <include android:id="@+id/includeSuperior" layout="@layout/navbar_admin_return"
        android:layout_width="0dp" android:layout_height="64dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView android:id="@+id/scrollContent" android:layout_width="0dp" android:layout_height="0dp"
        android:fillViewport="true" android:background="@color/background_layout"
        app:layout_constraintTop_toBottomOf="@id/includeSuperior" app:layout_constraintBottom_toTopOf="@id/includeInferior"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:id="@+id/contentContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="110dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/white">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="20dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tipos de dirección" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/black" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gestionar información del modelo" android:textSize="14sp" android:textColor="@color/subtitle" android:layout_marginTop="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal" android:gravity="center_vertical">
    <LinearLayout android:id="@+id/layoutSearch" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:background="@drawable/bg_button">
        <EditText android:id="@+id/fieldSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@android:color/transparent" android:hint="Buscar" android:textColorHint="@color/hint" />
    </LinearLayout>
    <LinearLayout android:id="@+id/actionNew" android:layout_width="100dp" android:layout_height="50dp" android:layout_marginStart="12dp" android:orientation="horizontal" android:gravity="center" android:background="@drawable/bg_button">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Crear" android:textColor="@color/black" android:textStyle="bold" android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
<LinearLayout android:id="@+id/dataList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>
    <include android:id="@+id/includeInferior" layout="@layout/navbar_admin_inferior" android:layout_width="0dp" android:layout_height="76dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
